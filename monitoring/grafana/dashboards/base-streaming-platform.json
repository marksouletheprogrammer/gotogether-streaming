      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "rate(kafka_server_broker_topic_metrics_bytes_in_total[5m])", "legendFormat": "in", "refId": "A"},
        {"expr": "rate(kafka_server_broker_topic_metrics_bytes_out_total[5m])", "legendFormat": "out", "refId": "B"}
      ],
