    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Five-minute producer record rate by client ID, filtered by Producer client ID. A zero rate is idle; missing telemetry is shown as No data. This is not broker byte throughput.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (client_id) (rate(mill_cuts_producer_records_sent_total{client_id=~\"${producer_client_id:regex}\"}[5m]))",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (client_id) (rate(mill_tool_events_producer_records_sent_total{client_id=~\"${producer_client_id:regex}\"}[5m]))",
