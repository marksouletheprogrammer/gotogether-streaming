{
  "type": "record",
  "name": "CncEventRecord",
  "namespace": "com.improving.gotogether.events",
  "fields": [
    {
      "name": "schema_version",
      "type": "string"
    },
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "kind",
      "type": "string"
    },
    {
      "name": "occurred_at",
      "type": "string"
    },
    {
      "name": "machine_id",
      "type": "string"
    },
    {
      "name": "tool_instance_id",
      "type": "string"
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "EventPayload",
        "fields": [
          {
            "name": "event_type",
            "type": "string"
          },
          {
            "name": "cut_index",
            "type": [
              "null",
              "int"
            ],
            "default": null
          },
          {
            "name": "component",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "confirmed_fault",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "planned",
            "type": [
              "null",
              "boolean"
            ],
            "default": null
          },
          {
            "name": "replacement_tool_instance_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    }
  ]
}
